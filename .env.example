# Baza danych PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crisis_db?schema=public"

# Redis (rate limiting, lockouts)
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Wygeneruj losowy sekret: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Port serwera
PORT=3000

# reCAPTCHA v2 (opcjonalne — bez kluczy weryfikacja captcha jest pomijana)
# Klucze utworzysz na https://www.google.com/recaptcha/admin/create
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# SMTP (opcjonalne — bez SMTP_HOST e-maile są tylko logowane do konsoli)
# UWAGA: linki resetu hasła i zaproszeń zawierają surowy, jednorazowy token
# (odpowiednik hasła — kto go ma, ten może przejąć konto). Bez SMTP_HOST ten
# token trafia w pełni do stdout/logów kontenera przy KAŻDYM resecie hasła i
# zaproszeniu (src/lib/email.ts, ConsoleEmailSender). Dopuszczalne tylko lokalnie
# w developmencie — na produkcji SMTP_HOST musi być skonfigurowany, inaczej
# każdy z dostępem do logów może przejąć dowolne konto.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="QFundation <no-reply@example.com>"
