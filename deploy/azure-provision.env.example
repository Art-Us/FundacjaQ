# Copy this file to deploy/azure-provision.env and fill in real values.
# azure-provision.env is gitignored — this .example file is the only one
# that should ever be committed.

DB_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_RANDOM_SECRET"

# Optional (leave empty to skip — matches .env.example semantics)
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="QFundation <no-reply@example.com>"