generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COORDINATOR
  VOLUNTEER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum ResourceStatus {
  AVAILABLE
  RESERVED
  IN_USE
  DEPLETED
}

enum AuditAction {
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_ACTIVATE
  USER_DEACTIVATE
  GMINA_CREATE
  GMINA_UPDATE
  GMINA_DELETE
  INVITE_CREATE
  INVITE_REVOKE
}

enum AuditEntityType {
  USER
  GMINA
  INVITE_TOKEN
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  passwordHash       String
  role               Role      @default(VOLUNTEER)
  organization       String?
  phone              String?
  gminaId            String?
  gmina              Gmina?    @relation(fields: [gminaId], references: [id])
  emailVerified      DateTime?
  isActive           Boolean   @default(true)
  lastActivatedAt    DateTime?
  lastDeactivatedAt  DateTime?
  deactivationReason String?
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  alertsCreated       Alert[]
  invitesCreated      InviteToken[]
  passwordResetTokens PasswordResetToken[]
  loginAttempts       LoginAttempt[]
}

model InviteToken {
  id          String    @id @default(cuid())
  email       String
  role        Role
  gminaId     String?
  gmina       Gmina?    @relation(fields: [gminaId], references: [id])
  tokenHash   String    @unique
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Gmina {
  id           String   @id @default(cuid())
  name         String   @unique
  powiat       String?
  voivodeship  String?
  latitude     Float?
  longitude    Float?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  alerts       Alert[]
  resources    Resource[]
  inviteTokens InviteToken[]
}

model ResourceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resources Resource[]
}

model Resource {
  id          String           @id @default(cuid())
  name        String
  description String?
  quantity    Int              @default(0)
  unit        String           @default("szt")
  status      ResourceStatus   @default(AVAILABLE)
  location    String?
  categoryId  String
  category    ResourceCategory @relation(fields: [categoryId], references: [id])
  gminaId     String
  gmina       Gmina            @relation(fields: [gminaId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Append-only admin action trail: who did what, to which record, when, and
// what it looked like before/after — with an optional revert. Deliberately
// has NO foreign keys to User/Gmina/InviteToken: those rows can be deleted
// (see the P2003 RESTRICT handling in the admin CRUD routes) and a RESTRICT
// here would block deleting the very thing being audited, so actor/entity
// identity is captured as a plain id plus a point-in-time snapshot instead
// of a live relation. `before`/`after` are built from an explicit per-entity
// allowlist (see lib/auditLog.ts) that never includes passwordHash or tokenHash.
model AuditLog {
  id  String @id @default(cuid())
  // A real DB-assigned monotonic sequence, used ONLY to order same-entity
  // rows for the cascading-revert chain (lib/auditLog.ts) — cuids are
  // roughly time-ordered but not guaranteed to be, so two rows created in
  // the same millisecond (or by different app instances) could otherwise
  // sort in the wrong causal order and make revertAuditLog undo them out of
  // sequence. Postgres serializes concurrent inserts' sequence assignment,
  // so this is reliable in a way `createdAt`/`id` alone are not.
  seq Int @default(autoincrement())
  actorId    String
  actorEmail String
  actorName  String?
  actorRole  Role
  action     AuditAction
  entityType AuditEntityType
  entityId   String
  gminaId    String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())

  // Set on THIS row once someone reverts the action it records.
  revertedAt   DateTime?
  revertedById String?

  // Set on the row created BY a revert, pointing back at what it reverted.
  isRevert  Boolean    @default(false)
  revertOfId String?
  revertOf   AuditLog?  @relation("AuditRevertChain", fields: [revertOfId], references: [id])
  revertedBy AuditLog[] @relation("AuditRevertChain")

  @@index([entityType, entityId, seq])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Alert {
  id          String      @id @default(cuid())
  title       String
  description String
  severity    Severity    @default(MEDIUM)
  status      AlertStatus @default(ACTIVE)
  location    String?
  authorId    String?
  author      User?       @relation(fields: [authorId], references: [id])
  gminaId     String
  gmina       Gmina       @relation(fields: [gminaId], references: [id])
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
