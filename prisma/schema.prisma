generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COORDINATOR
  VOLUNTEER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

// Zdarzenia codzienne (festyny, koncerty, zebrania) trzymamy w tej samej tabeli
// Alert co komunikaty kryzysowe — format danych jest identyczny, różni je tylko
// przeznaczenie. `kind` rozdziela oba widoki na mapie i chroni statystyki
// kryzysowe (patrz lib/dashboard.ts) od liczenia wydarzeń jako alertów.
enum AlertKind {
  ALERT // Komunikat kryzysowy
  EVENT // Zdarzenie codzienne
}

enum AlertCategory {
  // Kategorie komunikatów kryzysowych (kind = ALERT)
  HYDROLOGICAL // Ostrzeżenie hydrologiczne
  ROAD // Komunikat drogowy
  HUMANITARIAN // Pomoc humanitarna
  FIRE // Zagrożenie pożarowe
  INFRASTRUCTURE // Awaria infrastruktury
  GENERAL // Informacja ogólna

  // Kategorie zdarzeń codziennych (kind = EVENT)
  FESTIVAL // Festyn / święto miasta
  CONCERT // Koncert
  SPORT // Wydarzenie sportowe
  COMMUNITY // Spotkanie mieszkańców
  FAIR // Targi / jarmark
  CULTURE // Kultura / wystawa
  OTHER_EVENT // Inne wydarzenie
}

enum ResourceStatus {
  AVAILABLE
  RESERVED
  IN_USE
  DEPLETED
}

// Top-level grouping for ResourceCategory — the 4 buttons on the "Zgłoś nowy
// zasób" modal (fot. 6) and the 4 stat tiles/filter chips on Matryca Zasobów
// (fot. 1). Each ResourceCategory belongs to exactly one group.
enum ResourceGroup {
  PEOPLE
  WATER
  EQUIPMENT
  OTHER
}

// How soon a resource is available. Cumulative: a resource with H24 also
// shows up in the H48/H72/WEEK columns of the Matryca Zasobów table.
enum ResourceHorizon {
  H24
  H48
  H72
  WEEK
}

enum NeedUrgency {
  NORMAL
  PILNE
  KRYTYCZNY
}

enum NeedStatus {
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CLOSED
  CANCELLED
}

// No separate PROPOSED/accept step — a donor creates a ResourceAllocation
// directly in DELIVERY_AGREED. DELIVERED can be set by either side (donor or
// recipient, whoever confirms first); everything after that (RETURN_AGREED,
// recording returns) is the recipient's action alone — see
// docs/are-you-familiar-with-tidy-blum.md decision #3.
enum AllocationStatus {
  DELIVERY_AGREED
  DELIVERED
  RETURN_AGREED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum AuditAction {
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_ACTIVATE
  USER_DEACTIVATE
  GMINA_CREATE
  GMINA_UPDATE
  GMINA_DELETE
  ORGANIZATION_CREATE
  ORGANIZATION_UPDATE
  ORGANIZATION_DELETE
  INVITE_CREATE
  INVITE_REVOKE
  RESOURCE_CREATE
  RESOURCE_UPDATE
  RESOURCE_DELETE
  ALERT_NEED_CREATE
  ALERT_NEED_UPDATE
  ALERT_NEED_DELETE
  RESOURCE_ALLOCATION_CREATE
  RESOURCE_ALLOCATION_STATUS_CHANGE
  RESOURCE_ALLOCATION_RETURN
}

enum AuditEntityType {
  USER
  GMINA
  ORGANIZATION
  INVITE_TOKEN
  RESOURCE
  ALERT_NEED
  RESOURCE_ALLOCATION
}

model User {
  id                 String        @id @default(cuid())
  name               String?
  email              String        @unique
  passwordHash       String
  role               Role          @default(VOLUNTEER)
  organizationId     String?
  // Optional relation, but deliberately RESTRICT (not Prisma's SET-NULL
  // default for an optional FK) — an org with users still assigned to it
  // must not be deletable out from under them. gminaId below stays SET NULL
  // by contrast: that FK predates this one and hasn't been revisited, but a
  // gmina delete silently detaching its users while the delete route's own
  // error message claims it would be blocked is a known pre-existing
  // inconsistency, not a pattern to copy here.
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  phone              String?
  gminaId            String?
  gmina              Gmina?        @relation(fields: [gminaId], references: [id])
  emailVerified      DateTime?
  isActive           Boolean       @default(true)
  lastActivatedAt    DateTime?
  lastDeactivatedAt  DateTime?
  deactivationReason String?
  failedAttempts     Int           @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  alertsCreated                  Alert[]
  alertNeedsCreated              AlertNeed[]
  resourceAllocationsCreated     ResourceAllocation[]
  allocationReturnEventsRecorded AllocationReturnEvent[]
  allocationMessages             AllocationMessage[]
  alertMessages                  AlertMessage[]
  invitesCreated                 InviteToken[]
  passwordResetTokens            PasswordResetToken[]
  loginAttempts                  LoginAttempt[]
}

model InviteToken {
  id          String    @id @default(cuid())
  email       String
  role        Role
  gminaId     String?
  gmina       Gmina?    @relation(fields: [gminaId], references: [id])
  tokenHash   String    @unique
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // GET /api/admin/login-attempts also supports a substring search on email
  // (Prisma `contains`, translated to a leading-wildcard ILIKE), which this
  // plain btree index can't accelerate — that would need a pg_trgm GIN index
  // on email, requiring the extension to be enabled on the database. Left as
  // a known trade-off for now: the 90-day retention cleanup (lib/cleanup.ts)
  // bounds this table's size, so a full scan stays cheap unless login volume
  // grows substantially.
  @@index([email, createdAt])
}

model Gmina {
  id           String   @id @default(cuid())
  name         String   @unique
  powiat       String?
  voivodeship  String?
  latitude     Float?
  longitude    Float?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users         User[]
  alerts        Alert[]
  resources     Resource[]
  inviteTokens  InviteToken[]
  organizations Organization[]
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  street           String?
  houseNumber      String?
  apartmentNumber  String?
  city             String?
  postalCode       String?
  gminaId          String
  gmina            Gmina    @relation(fields: [gminaId], references: [id])
  // Contact person for this organization — deliberately separate from any
  // User account (an organization's day-to-day contact may not be, or ever
  // become, a user of this system).
  contactFirstName String?
  contactLastName  String?
  contactPhone     String?
  contactEmail     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]
  alerts           Alert[]
  resources        Resource[]
  allocationsGiven ResourceAllocation[] @relation("Donor")

  // Scoped to (name, gmina) rather than a global unique name — the same
  // organization name plausibly recurs across different gminas (e.g. a local
  // branch of a national charity), so only an exact duplicate within the
  // same gmina is treated as "the same organization" (mirrors createGmina's
  // case/whitespace-insensitive matching, see lib/organization.ts).
  @@unique([name, gminaId])
}

model ResourceCategory {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  icon        String?
  group       ResourceGroup @default(OTHER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  resources           Resource[]
  alertNeeds          AlertNeed[]
  resourceAllocations ResourceAllocation[]
}

model Resource {
  id               String           @id @default(cuid())
  name             String
  description      String?
  quantity         Int              @default(0)
  unit             String           @default("szt")
  status           ResourceStatus   @default(AVAILABLE)
  location         String?
  categoryId       String
  category         ResourceCategory @relation(fields: [categoryId], references: [id])
  // gminaId is kept as a derived geo field (filled from organization.gminaId
  // at creation, for fast geo-scoped filtering) — the UI no longer lets it be
  // edited directly, since ownership now flows through organizationId.
  gminaId          String
  gmina            Gmina            @relation(fields: [gminaId], references: [id])
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  horizon          ResourceHorizon  @default(H24)
  // Sum of this resource's active (non-terminal) ResourceAllocation
  // quantities — how much of `quantity` is currently spoken for.
  reservedQuantity Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  allocations ResourceAllocation[]

  @@index([organizationId])
  @@index([gminaId, categoryId, horizon])
}

// Append-only admin action trail: who did what, to which record, when, and
// what it looked like before/after — with an optional revert. Deliberately
// has NO foreign keys to User/Gmina/InviteToken: those rows can be deleted
// (see the P2003 RESTRICT handling in the admin CRUD routes) and a RESTRICT
// here would block deleting the very thing being audited, so actor/entity
// identity is captured as a plain id plus a point-in-time snapshot instead
// of a live relation. `before`/`after` are built from an explicit per-entity
// allowlist (see lib/auditLog.ts) that never includes passwordHash or tokenHash.
model AuditLog {
  id         String          @id @default(cuid())
  // A real DB-assigned monotonic sequence, used ONLY to order same-entity
  // rows for the cascading-revert chain (lib/auditLog.ts) — cuids are
  // roughly time-ordered but not guaranteed to be, so two rows created in
  // the same millisecond (or by different app instances) could otherwise
  // sort in the wrong causal order and make revertAuditLog undo them out of
  // sequence. Postgres serializes concurrent inserts' sequence assignment,
  // so this is reliable in a way `createdAt`/`id` alone are not.
  seq        Int             @default(autoincrement())
  actorId    String
  actorEmail String
  actorName  String?
  actorRole  Role
  action     AuditAction
  entityType AuditEntityType
  entityId   String
  gminaId    String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())

  // Set on THIS row once someone reverts the action it records.
  revertedAt   DateTime?
  revertedById String?

  // Set on the row created BY a revert, pointing back at what it reverted.
  isRevert   Boolean    @default(false)
  revertOfId String?
  revertOf   AuditLog?  @relation("AuditRevertChain", fields: [revertOfId], references: [id])
  revertedBy AuditLog[] @relation("AuditRevertChain")

  @@index([entityType, entityId, seq])
  @@index([actorId, createdAt])
  @@index([createdAt])
  // GET /api/admin/logs also supports filtering by gminaId alone (or
  // combined with a date range), always ordered by seq — without this, that
  // filter combination falls back to scanning the createdAt/seq order or the
  // whole table as the log grows within its retention window.
  @@index([gminaId, seq])
}

model Alert {
  id             String        @id @default(cuid())
  title          String
  description    String
  kind           AlertKind     @default(ALERT)
  severity       Severity      @default(MEDIUM)
  status         AlertStatus   @default(ACTIVE)
  category       AlertCategory @default(GENERAL)
  location       String?
  latitude       Float?
  longitude      Float?
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id])
  // The org that created this alert — filled once from session.user.organizationId
  // at creation (see POST /api/alerts) and never changed afterwards. Kept as
  // its own field rather than derived from author.organizationId because
  // authorId is optional, making that path unreliable for a value everything
  // else (ownership/authz checks) depends on.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  gminaId        String
  gmina          Gmina         @relation(fields: [gminaId], references: [id])
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  needs       AlertNeed[]
  allocations ResourceAllocation[]
  messages    AlertMessage[]

  @@index([organizationId])
}

// "Zapotrzebowanie na zasoby" — a concrete need declared under an alert (e.g.
// "need 6 reinforced tarpaulins, critical"). Donors respond to this by
// creating a ResourceAllocation (see model below, added in the next step).
model AlertNeed {
  id                String           @id @default(cuid())
  alertId           String
  alert             Alert            @relation(fields: [alertId], references: [id], onDelete: Cascade)
  categoryId        String
  category          ResourceCategory @relation(fields: [categoryId], references: [id])
  title             String
  description       String?
  quantityNeeded    Int
  // Denormalized running total of quantities allocated toward this need —
  // recalculated inside the same transaction as each ResourceAllocation
  // create (see src/lib/allocations.ts, added in Крок 17).
  quantityFulfilled Int              @default(0)
  unit              String           @default("szt")
  urgency           NeedUrgency      @default(NORMAL)
  status            NeedStatus       @default(OPEN)
  createdById       String?
  createdBy         User?            @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  allocations ResourceAllocation[]

  @@index([alertId])
}

// The heart of the whole feature: one row = one concrete arrangement of
// "donor org gives recipient org N units of resource X for alert Y". Created
// directly in DELIVERY_AGREED (no separate PROPOSED/accept step) — the donor
// declares delivery is agreed, and DELIVERED can then be set by either side
// (whoever confirms first). Everything after DELIVERED (RETURN_AGREED,
// recording returns) is the recipient's action alone — see decision #3 in
// docs/are-you-familiar-with-tidy-blum.md.
model ResourceAllocation {
  id                    String           @id @default(cuid())
  needId                String?
  need                  AlertNeed?       @relation(fields: [needId], references: [id], onDelete: SetNull)
  alertId               String
  alert                 Alert            @relation(fields: [alertId], references: [id], onDelete: Cascade)
  resourceId            String?
  resource              Resource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  // categoryId/itemName are a snapshot of the source resource at the moment
  // of allocation — they survive the source Resource being edited or deleted
  // later, so history stays accurate even if the underlying catalog entry
  // changes.
  categoryId            String
  category              ResourceCategory @relation(fields: [categoryId], references: [id])
  itemName              String
  quantity              Int
  quantityReturned      Int              @default(0)
  quantityNotReturnable Int              @default(0)
  unit                  String           @default("szt")
  donorOrgId            String
  donorOrg              Organization     @relation("Donor", fields: [donorOrgId], references: [id])
  // Snapshot of alert.organizationId at creation time — deliberately not a
  // declared Prisma relation (no recipientOrg field), same as the spec.
  recipientOrgId        String?
  status                AllocationStatus @default(DELIVERY_AGREED)
  deliveredAt           DateTime?
  returnAgreedAt        DateTime?
  createdById           String?
  createdBy             User?            @relation(fields: [createdById], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  returnEvents AllocationReturnEvent[]
  messages     AllocationMessage[]

  @@index([alertId, status])
  @@index([donorOrgId, status])
}

// Journal of (partial) returns (R5, R9) — one row per actual return action.
// Summing quantityReturned/quantityNotReturnable across all rows for an
// allocation drives its final status (see src/lib/allocations.ts, Крок 17)
// and the Resource.quantity/reservedQuantity adjustments described there.
model AllocationReturnEvent {
  id                    String             @id @default(cuid())
  allocationId          String
  allocation            ResourceAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  quantityReturned      Int                @default(0)
  quantityNotReturnable Int                @default(0)
  notReturnableReason   String?
  message               String? // R4 — surfaced on /zasoby's inbox, not just this allocation's history
  // Filled manually in the same return form as the quantities (R5) — not
  // `now()` — the person recording this may be logging a return that
  // physically happened earlier.
  returnedAt            DateTime
  recordedById          String?
  recordedBy            User?              @relation(fields: [recordedById], references: [id])
  createdAt             DateTime           @default(now())

  @@index([allocationId])
}

// Narrow donor↔recipient chat around one specific ResourceAllocation (e.g.
// "when will you drop it off?" / "delivered, please wait on site") — not to
// be confused with AlertMessage below, which is the broad per-alert forum.
model AllocationMessage {
  id           String             @id @default(cuid())
  allocationId String
  allocation   ResourceAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?              @relation(fields: [authorId], references: [id])
  body         String
  createdAt    DateTime           @default(now())

  @@index([allocationId, createdAt])
}

// R12 — the broad per-alert forum, not tied to one specific resource
// allocation (unlike AllocationMessage above): everyone involved with the
// alert (owner org + all donor orgs, plus ADMIN/COORDINATOR) can post here.
// Visible from the map/[alertId] subpage.
model AlertMessage {
  id          String   @id @default(cuid())
  alertId     String
  alert       Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  // Snapshot of the author's organization at post time — deliberately not a
  // declared Prisma relation, same pattern as ResourceAllocation.recipientOrgId.
  authorOrgId String?
  body        String
  createdAt   DateTime @default(now())

  @@index([alertId, createdAt])
}
